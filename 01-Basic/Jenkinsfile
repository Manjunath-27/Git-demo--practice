pipeline{
    agent any
    stages{
        stage('First'){
            steps{
                 sh'''
                     echo "Hello this is groovy..."
                 '''
             }
         }
            stage('Middle'){
                 steps{
                     sh'''
                         echo "Middle stage.."
                    '''
            }
        }
        stage('Last'){
            steps{
                sh'''
                    echo "This is Last Stage..."
                '''
            }
        }
    }
}       